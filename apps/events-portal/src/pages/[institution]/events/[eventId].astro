---
import PortalLayout from "../../../layouts/PortalLayout.astro";
import { portalApi } from "../../../lib/api";
import { MedmindEventDetail as MedmindEventDetailReact } from "../../../components/medmind/MedmindEventDetail";
import "../../../styles/tailwind.css";

const { institution, eventId } = Astro.params;
if (!institution || !eventId)
  return new Response("No encontrado", { status: 404 });

let listing;
let event;
try {
  [listing, event] = await Promise.all([
    portalApi.events(institution),
    portalApi.event(institution, eventId),
  ]);
} catch {
  return new Response("Evento no encontrado", { status: 404 });
}

const shortDate = new Intl.DateTimeFormat("es-PE", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const timeOnly = new Intl.DateTimeFormat("es-PE", {
  hour: "2-digit",
  minute: "2-digit",
});

const activities = event.editions.flatMap((edition) =>
  edition.activities.map((a) => ({
    ...a,
    editionName: edition.name,
    location: edition.location,
  })),
);
const activeEdition =
  event.editions.find((edition) => edition.isCurrent) || event.editions[0];
const heroMedia = event.heroMedia;
const heroVideo = heroMedia?.mimeType.startsWith("video/")
  ? heroMedia.url
  : undefined;
const defaultFallbackBanner =
  "https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=2000&q=80";
const heroImage =
  heroMedia && !heroVideo
    ? heroMedia.url
    : activeEdition?.coverUrl ||
      event.coverUrl ||
      listing.organization.coverUrl ||
      defaultFallbackBanner;
const metaImage = activeEdition?.metaThumbnailUrl || heroImage;

const eventDescription =
  activeEdition?.description || event.details?.content || event.description;
const speakers =
  activeEdition?.participants
    .map((participant) => participant.profile)
    .filter(Boolean) || [];

const forms = event.registrationForms || [];
const mainForm = forms.find((form) => form.purpose === "MAIN");
const secondaryForms = forms.filter((form) => form.purpose !== "MAIN");

const startDateObj = activeEdition?.startDate
  ? new Date(activeEdition.startDate)
  : event.startDate
    ? new Date(event.startDate)
    : null;
const endDateObj = activeEdition?.endDate
  ? new Date(activeEdition.endDate)
  : event.endDate
    ? new Date(event.endDate)
    : null;

const modalityRaw = activeEdition?.modality || event.eventMode || "PRESENCIAL";
const modalityText = modalityRaw.toUpperCase();
const isPresencial = modalityText !== "VIRTUAL" && modalityText !== "ONLINE";

const eventLat = activeEdition?.latitude ?? event.latitude ?? null;
const eventLng = activeEdition?.longitude ?? event.longitude ?? null;
const eventVenue = activeEdition?.location || event.venueAddress || null;
const hasMapData = isPresencial && (eventLat !== null || !!eventVenue);

const mapEmbedUrl =
  eventLat !== null && eventLng !== null
    ? `https://www.openstreetmap.org/export/embed.html?bbox=${eventLng - 0.008}%2C${eventLat - 0.005}%2C${eventLng + 0.008}%2C${eventLat + 0.005}&layer=mapnik&marker=${eventLat}%2C${eventLng}`
    : eventVenue
      ? `https://maps.google.com/maps?q=${encodeURIComponent(eventVenue)}&t=&z=15&ie=UTF8&iwloc=&output=embed`
      : "";

const mapExternalUrl =
  eventLat !== null && eventLng !== null
    ? `https://www.google.com/maps/search/?api=1&query=${eventLat},${eventLng}`
    : eventVenue
      ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(eventVenue)}`
      : "";
const isMedmind =
  listing.organization.name.trim().toLowerCase() === "medmind" ||
  listing.organization.slug?.trim().toLowerCase() === "medmind" ||
  institution.trim().toLowerCase() === "medmind";
---

<PortalLayout
  organization={listing.organization}
  title={`${event.eventName}${activeEdition ? ` · ${activeEdition.name}` : ""} · ${listing.organization.name}`}
  description={eventDescription || undefined}
  imageUrl={metaImage}
  bare={isMedmind}
  registrationUrl={mainForm
    ? `/${institution}/register/${mainForm.slug}`
    : undefined}
>
  {isMedmind ? (
    <MedmindEventDetailReact
      client:load
      institution={institution}
      organization={listing.organization}
      event={event}
      edition={activeEdition}
      speakers={speakers}
      activities={activities}
      form={mainForm || secondaryForms[0]}
      heroImage={heroImage}
      heroVideo={heroVideo}
      apiUrl={portalApi.apiUrl}
    />
  ) : (
  <article class="event-detail-page">
    <!-- ========================================================================= -->
    <!-- 1. CINEMATIC HERO (The Design Conference style)                           -->
    <!-- ========================================================================= -->
    <header class="tdc-hero">
      <div
        class="tdc-hero-bg"
        style={heroImage
          ? `background-image: url(${heroImage})`
          : listing.organization.coverUrl
            ? `background-image: url(${listing.organization.coverUrl})`
            : undefined}
      >
        {
          heroVideo && (
            <video
              class="tdc-hero-video"
              autoplay
              muted
              loop
              playsinline
              poster={heroImage}
            >
              <source src={heroVideo} type={heroMedia?.mimeType} />
            </video>
          )
        }
      </div>
      <div class="tdc-hero-vignette"></div>

      <div class="tdc-container tdc-hero-container">
        <div class="tdc-hero-center">
          <div class="tdc-tag-row">
            <span class="tdc-badge-pill outline">{modalityText}</span>
            {activeEdition?.name && <span class="tdc-badge-pill light">{activeEdition.name}</span>}
            {startDateObj && <span class="tdc-badge-pill dark">{shortDate.format(startDateObj)}</span>}
          </div>

          <h1 class="tdc-hero-headline">
            {event.eventName}
          </h1>

          <div class="tdc-hero-interactive-row">
            <div class="tdc-hero-actions">
              {
                mainForm ? (
                  <a
                    href={`/${institution}/register/${mainForm.slug}`}
                    class="tdc-action-pill"
                  >
                    <span>Inscribirme ahora</span>
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </a>
                ) : (
                  <a href="#detalles" class="tdc-action-pill">
                    <span>Ver detalles</span>
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </a>
                )
              }
            </div>

            {
              startDateObj && (
                <div
                  class="tdc-hero-countdown-prominent"
                  data-event-date={startDateObj.toISOString()}
                >
                  <div class="countdown-eyebrow">
                    <span class="countdown-pulse-dot"></span>
                    <span class="cd-tag">TIEMPO RESTANTE</span>
                  </div>
                  <div class="cd-boxes">
                    <div class="cd-box">
                      <strong class="cd-num" data-unit="days">00</strong>
                      <span class="cd-lbl">DÍAS</span>
                    </div>
                    <span class="cd-div">:</span>
                    <div class="cd-box">
                      <strong class="cd-num" data-unit="hours">00</strong>
                      <span class="cd-lbl">HORAS</span>
                    </div>
                    <span class="cd-div">:</span>
                    <div class="cd-box">
                      <strong class="cd-num" data-unit="minutes">00</strong>
                      <span class="cd-lbl">MIN</span>
                    </div>
                    <span class="cd-div">:</span>
                    <div class="cd-box">
                      <strong class="cd-num" data-unit="seconds">00</strong>
                      <span class="cd-lbl">SEG</span>
                    </div>
                  </div>
                </div>
              )
            }
          </div>
        </div>

        <!-- Hero Bottom Meta Bar -->
        <div class="tdc-hero-bottom-bar">
          <span class="bottom-credit"
            >Organizado por: <strong>{listing.organization.name}</strong></span
          >
          <span class="bottom-tag"
            >{
              activeEdition?.location ||
                event.venueAddress ||
                `${activeEdition?.modality || event.eventMode || 'Presencial'} · Sede oficial`
            }</span
          >
        </div>
      </div>
    </header>

    <!-- Breadcrumb after the detail hero -->
    <div class="event-breadcrumb-bar">
      <div class="tdc-container">
        <a href={`/${institution}`} class="back-link">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          <span>Volver al portal de {listing.organization.name}</span>
        </a>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 2. OVERVIEW & KEY SPECIFICATIONS (Keep Competitive & Connected style)     -->
    <!-- ========================================================================= -->
    <section class="event-overview-section" id="detalles">
      <div class="tdc-container">
        <div class="overview-split-grid">
          <!-- Left Column: Story & Narrative -->
          <div class="overview-story">
            <span class="section-tag">INFORMACIÓN & OBJETIVOS</span>
            <h2 class="tdc-massive-heading">Propuesta de la edición</h2>
            <div class="rich-desc">
              <p>
                {
                  eventDescription ||
                    "Te damos la bienvenida a esta experiencia oficial diseñada para conectar con especialistas líderes, adquirir herramientas prácticas e impulsar tu desarrollo profesional."
                }
              </p>
            </div>
          </div>

          <!-- Right Column: Structured Specifications Table -->
          <div class="overview-specs-panel">
            <div class="spec-block">
              <span class="spec-label">FECHAS</span>
              <p class="spec-value">
                {
                  startDateObj
                    ? shortDate.format(startDateObj)
                    : "Por confirmar"
                }
                {
                  endDateObj && endDateObj.getTime() !== startDateObj?.getTime()
                    ? ` — ${shortDate.format(endDateObj)}`
                    : ""
                }
              </p>
            </div>

            <div class="spec-block">
              <span class="spec-label">HORARIO ESTIMADO</span>
              <p class="spec-value">
                {
                  startDateObj
                    ? `${timeOnly.format(startDateObj)} hrs`
                    : "Horario por definir"
                }
              </p>
            </div>

            <div class="spec-block">
              <span class="spec-label">MODALIDAD DE PARTICIPACIÓN</span>
              <p class="spec-value">
                {
                  activeEdition?.modality ||
                    event.eventMode ||
                    "Presencial y transmisión en vivo"
                }
              </p>
            </div>

            {
              (activeEdition?.location || event.venueAddress) && (
                <div class="spec-block spec-block-location">
                  <span class="spec-label">SEDE / UBICACIÓN</span>
                  <p class="spec-value">
                    {activeEdition?.location || event.venueAddress}
                  </p>
                  {hasMapData && (
                    <div class="mini-map-wrapper">
                      <iframe
                        title={`Ubicación de ${event.eventName}`}
                        width="100%"
                        height="150"
                        class="mini-map-iframe"
                        loading="lazy"
                        allowfullscreen
                        src={mapEmbedUrl}
                      ></iframe>
                      <div class="mini-map-footer">
                        {eventLat !== null && eventLng !== null && (
                          <span class="mini-coords">{eventLat.toFixed(4)}, {eventLng.toFixed(4)}</span>
                        )}
                        {mapExternalUrl && (
                          <a
                            href={mapExternalUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mini-map-link"
                          >
                            <span>Abrir en Maps</span>
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                              <polyline points="15 3 21 3 21 9"></polyline>
                              <line x1="10" y1="14" x2="21" y2="3"></line>
                            </svg>
                          </a>
                        )}
                      </div>
                    </div>
                  )}
                </div>
              )
            }

            <div class="spec-block">
              <span class="spec-label">INSCRIPCIONES</span>
              <p class="spec-value">
                {
                  mainForm
                    ? "Habilitadas mediante registro oficial"
                    : "Disponibles próximamente"
                }
              </p>
            </div>

            <div class="spec-block">
              <span class="spec-label">ORGANIZADO POR</span>
              <p class="spec-value">{listing.organization.name}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 3. PRESENTATIONS & TALKS (CYPHERCON Presentations Reference style)        -->
    <!-- ========================================================================= -->
    {
      activities.length > 0 && (
        <section class="event-presentations-section" id="presentaciones">
          <div class="tdc-container">
            <div class="section-header-row">
              <div>
                <span class="section-tag">SESIONES & CHARLAS</span>
                <h2 class="tdc-massive-heading">Presentaciones & Sesiones</h2>
              </div>
              {speakers.length > 0 && (
                <a href="#ponentes" class="accent-pill-link">
                  <span>Ver Ponentes</span>
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </a>
              )}
            </div>

            <div class="presentations-grid">
              {activities.map((act, index) => (
                <article class="presentation-card">
                  <div class="presentation-card-header">
                    <span class="pres-badge">SESIÓN 0{index + 1}</span>
                    {act.startsAt && (
                      <span class="pres-time">
                        {timeOnly.format(new Date(act.startsAt))} hrs
                      </span>
                    )}
                    {act.location && (
                      <span class="pres-location">{act.location}</span>
                    )}
                  </div>

                  <h3 class="presentation-title">{act.title}</h3>
                  <p class="presentation-desc">
                    {act.description ||
                      "Sesión temática con análisis técnico, casos de estudio y espacio para preguntas."}
                  </p>

                  <div class="presentation-footer">
                    <span class="presentation-tag">
                      {act.editionName || event.eventName}
                    </span>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ========================================================================= -->
    <!-- 4. MEET OUR SPEAKERS (Meet our Speakers Reference style)                  -->
    <!-- ========================================================================= -->
    {
      speakers.length > 0 && (
        <section class="event-speakers-section" id="ponentes">
          <div class="tdc-container">
            <div class="section-header-row">
              <div>
                <span class="section-tag purple">EXPOSITORES & EXPERTOS</span>
                <h2 class="tdc-massive-heading">Conoce a los Ponentes</h2>
              </div>
              <span class="section-count-pill">
                {speakers.length}{" "}
                {speakers.length === 1 ? "expositor" : "expositores"}
              </span>
            </div>

            <div class="speakers-grid">
              {speakers.map((speaker) => (
                <article class="speaker-card">
                  <div class="speaker-photo-wrap">
                    {speaker.avatarUrl ? (
                      <img
                        src={speaker.avatarUrl}
                        alt={[speaker.firstName, speaker.lastName]
                          .filter(Boolean)
                          .join(" ")}
                        class="speaker-photo"
                        loading="lazy"
                      />
                    ) : (
                      <div class="speaker-photo-placeholder">
                        <span>
                          {speaker.firstName?.[0] || "P"}
                          {speaker.lastName?.[0] || ""}
                        </span>
                      </div>
                    )}
                  </div>

                  <div class="speaker-info">
                    <h3 class="speaker-name">
                      {[speaker.firstName, speaker.lastName]
                        .filter(Boolean)
                        .join(" ") || "Ponente"}
                    </h3>
                    <p class="speaker-bio">
                      {speaker.bio ||
                        "Expositor invitado en esta edición oficial."}
                    </p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ========================================================================= -->
    <!-- 5. REGISTRATION FORMS / PASSES                                            -->
    <!-- ========================================================================= -->
    <section class="event-registration-section" id="inscripciones">
      <div class="tdc-container">
        <div class="section-header-row">
          <div>
            <span class="section-tag">ACCESO OFICIAL</span>
            <h2 class="tdc-massive-heading">Inscripciones & Entradas</h2>
          </div>
        </div>

        {
          mainForm && (
            <a
              href={`/${institution}/register/${mainForm.slug}`}
              class="main-registration-panel"
            >
              <div class="main-reg-left">
                <span class="ticket-badge">REGISTRO PRINCIPAL</span>
                <h3 class="main-reg-title">{mainForm.title}</h3>
                <p class="main-reg-desc">
                  {mainForm.description ||
                    "Completa tu inscripción oficial como participante para obtener tu pase de ingreso."}
                </p>
              </div>
              <div class="main-registration-action">
                <span class="action-circle-btn">
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </span>
                <span class="action-text">Completar inscripción</span>
              </div>
            </a>
          )
        }

        {
          secondaryForms.length > 0 ? (
            <div class="reg-forms-grid">
              {secondaryForms.map((f) => (
                <a
                  href={`/${institution}/register/${f.slug}`}
                  class="reg-ticket-card"
                >
                  <div class="ticket-header">
                    <span class="ticket-badge">FORMULARIO ESPECIALIZADO</span>
                    <h3 class="ticket-title">{f.title}</h3>
                    <p class="ticket-desc">
                      {f.description ||
                        "Formulario de registro habilitado para este segmento de participación."}
                    </p>
                  </div>

                  <div class="ticket-footer">
                    <div class="ticket-action-row">
                      <span class="action-circle-btn">
                        <svg
                          width="15"
                          height="15"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                        >
                          <path d="M5 12h14" />
                          <path d="m12 5 7 7-7 7" />
                        </svg>
                      </span>
                      <span class="action-text">Completar registro</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            !mainForm && (
              <div class="empty-reg-box">
                <h3>Inscripciones próximamente</h3>
                <p>
                  El registro oficial para este evento estará habilitado en
                  breve.
                </p>
              </div>
            )
          )
        }
      </div>
    </section>

    {
      mainForm && (
        <aside class="registration-banner" id="registration-banner">
          <div class="banner-content">
            <span class="banner-text">
              Las inscripciones para <strong>{event.eventName}</strong> se
              encuentran abiertas.
            </span>
            <div class="banner-actions">
              <a
                href={`/${institution}/register/${mainForm.slug}`}
                class="banner-btn"
              >
                Inscribirme
              </a>
              <button
                type="button"
                aria-label="Cerrar aviso"
                data-close-banner
                class="banner-close"
              >
                ×
              </button>
            </div>
          </div>
        </aside>
      )
    }
  </article>
  )}
</PortalLayout>

<script>
  // Countdown Timer Script (Days, Hours, Minutes, Seconds)
  document
    .querySelectorAll<HTMLElement>("[data-event-date]")
    .forEach((node) => {
      const target = new Date(node.dataset.eventDate || "").getTime();
      const daysEl = node.querySelector<HTMLElement>('[data-unit="days"]');
      const hoursEl = node.querySelector<HTMLElement>('[data-unit="hours"]');
      const minEl = node.querySelector<HTMLElement>('[data-unit="minutes"]');
      const secEl = node.querySelector<HTMLElement>('[data-unit="seconds"]');

      const tick = () => {
        const remaining = Math.max(0, target - Date.now());
        const days = Math.floor(remaining / 864e5);
        const hours = Math.floor((remaining % 864e5) / 36e5);
        const minutes = Math.floor((remaining % 36e5) / 6e4);
        const seconds = Math.floor((remaining % 6e4) / 1e3);

        if (daysEl) daysEl.textContent = String(days).padStart(2, "0");
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, "0");
        if (minEl) minEl.textContent = String(minutes).padStart(2, "0");
        if (secEl) secEl.textContent = String(seconds).padStart(2, "0");
      };
      tick();
      setInterval(tick, 1000);
    });

  document
    .querySelector("[data-close-banner]")
    ?.addEventListener("click", () =>
      document.querySelector("#registration-banner")?.remove(),
    );
</script>

<style>
  .event-detail-page {
    background: #080a0d;
    min-height: 100vh;
    color: #f1f5f9;
    font-family: "Inter", sans-serif;
  }

  /* Breadcrumb Navigation */
  .event-breadcrumb-bar {
    padding: 1.25rem 0;
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: none;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s;
  }
  .back-link:hover {
    color: #ffffff;
  }

  /* ========================================================================= */
  /* 1. CINEMATIC HERO (The Design Conference style - Same as Portal Home)     */
  /* ========================================================================= */
  .tdc-hero {
    position: relative;
    min-height: min(720px, 86vh);
    display: flex;
    align-items: flex-end;
    background-color: #0c0e12;
    overflow: hidden;
    padding: 6rem 0 3.5rem;
  }
  .tdc-hero-bg {
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    opacity: 0.55;
    transform: scale(1.02);
  }
  .tdc-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tdc-hero-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at center,
        rgba(12, 14, 18, 0.3) 0%,
        rgba(12, 14, 18, 0.95) 100%
      ),
      linear-gradient(180deg, rgba(12, 14, 18, 0.3) 0%, #0c0e12 100%);
  }
  .tdc-hero-container {
    position: relative;
    z-index: 10;
    width: min(100% - 2rem, 1320px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 480px;
  }
  .tdc-hero-center {
    max-width: 900px;
    margin: 0 0 2.5rem;
  }
  .tdc-tag-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
