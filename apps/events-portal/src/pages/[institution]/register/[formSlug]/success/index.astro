---
import PortalLayout from '../../../../../layouts/PortalLayout.astro';
import { portalApi } from '../../../../../lib/api';

const { institution, formSlug } = Astro.params;
if (!institution || !formSlug) return new Response('Página no encontrada', { status: 404 });
let listing: Awaited<ReturnType<typeof portalApi.events>>;
let form: any;
try {
  [listing, form] = await Promise.all([
    portalApi.events(institution),
    fetch(`${portalApi.apiUrl}/public/registration-forms/${encodeURIComponent(formSlug)}`).then((response) => response.ok ? response.json() : Promise.reject()),
  ]);
} catch { return new Response('Página no disponible', { status: 404 }); }
const eventDate = form.edition?.startDate ? new Date(form.edition.startDate) : null;
const message = form.thankYouMessage || 'Tu inscripción fue recibida correctamente. Te enviaremos los detalles al correo registrado.';
---

<PortalLayout organization={listing.organization} title={`Inscripción confirmada · ${form.title}`}>
  <main class="success-page">
    <section class="success-card">
      <div class="plane" aria-hidden="true">✈</div>
      <p class="eyebrow">INSCRIPCIÓN CONFIRMADA</p>
      <h1>¡Gracias por tu inscripción!</h1>
      <p class="message">{message}</p>
      {eventDate && <div class="event-summary"><span>📅</span><strong>{eventDate.toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric' })}</strong><span>◷</span><strong>{eventDate.toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit' })}</strong></div>}
      <a class="back" href={`/${institution}/events/${form.mainEventId}`}>Volver al evento</a>
    </section>
  </main>
</PortalLayout>

<style>
  .success-page{min-height:calc(100vh - 72px);display:grid;place-items:center;padding:3rem 1.5rem;background:#fff}.success-card{width:min(100%,680px);text-align:center;color:#172033}.plane{margin:0 auto 1.5rem;width:92px;height:92px;display:grid;place-items:center;border-radius:50%;background:#e7f8f5;color:#00a98f;font-size:3rem;transform:rotate(-20deg)}.eyebrow{margin:0;color:#00a98f;font-size:.75rem;font-weight:800;letter-spacing:.15em}.success-card h1{margin:.65rem 0 1rem;font-size:clamp(2rem,6vw,3.4rem);letter-spacing:-.04em}.message{max-width:540px;margin:auto;color:#5f6c7a;font-size:1.05rem;line-height:1.7}.event-summary{display:flex;align-items:center;justify-content:center;gap:.7rem;flex-wrap:wrap;margin:2rem auto;padding:1.15rem;border:1px solid #e1e8e7;border-radius:14px;background:#fbfdfd;font-size:.95rem}.event-summary span{color:#00a98f;font-size:1.15rem}.back{display:inline-flex;border-radius:999px;padding:.85rem 1.35rem;background:#00a98f;color:#fff;text-decoration:none;font-weight:700}.back:hover{background:#008d77}
</style>
