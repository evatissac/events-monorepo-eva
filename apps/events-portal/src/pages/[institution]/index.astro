---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { portalApi, type PortalEvent } from '../../lib/api';

const { institution } = Astro.params;
if (!institution) return Astro.redirect('/');

let data;
try {
  data = await portalApi.events(institution);
} catch {
  return new Response('Institución no encontrada', { status: 404 });
}

const dateFormatter = new Intl.DateTimeFormat('es-PE', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

const events: PortalEvent[] = data.events || [];
const organization = data.organization;
const portal = organization.portal?.isPublished === false ? null : organization.portal;

// Extract real venues and modes dynamically
const venues = Array.from(new Set(events.map((e) => e.venueAddress).filter(Boolean))) as string[];
const modes = Array.from(new Set(events.map((e) => e.eventMode).filter(Boolean))) as string[];

const featuredEvent = (portal?.featuredEventId
  ? events.find((event) => event.id === portal.featuredEventId)
  : events[0]) as PortalEvent | undefined;
---

<PortalLayout
  organization={organization}
  title={`${organization.name} · Experiencias & Eventos`}
  venues={venues}
>
  <!-- ========================================================================= -->
  <!-- 1. CINEMATIC HERO (The Design Conference style - Screenshot 1)           -->
  <!-- ========================================================================= -->
  <section class="tdc-hero">
    <div
      class="tdc-hero-bg"
      style={portal?.heroImageUrl ? `background-image: url(${portal.heroImageUrl})` : (featuredEvent?.coverUrl ? `background-image: url(${featuredEvent.coverUrl})` : (organization.coverUrl ? `background-image: url(${organization.coverUrl})` : undefined))}
    ></div>
    <div class="tdc-hero-vignette"></div>

    <div class="tdc-container tdc-hero-container">
      <div class="tdc-hero-center">
        <div class="tdc-tag-row">
          <span class="tdc-badge-pill outline">Evento destacado</span>
          <span class="tdc-badge-pill light">{featuredEvent?.eventMode?.toUpperCase() || 'EVENTO OFICIAL'}</span>
          <span class="tdc-badge-pill dark">{events.length} {events.length === 1 ? 'EVENTO' : 'EVENTOS PUBLICADOS'}</span>
        </div>

        <h1 class="tdc-hero-headline">
          {portal?.heroTitle || `Descubre los próximos eventos de ${organization.name}`}
        </h1>

        {featuredEvent && organization.description && (
          <p class="tdc-hero-organization-copy"><span>{organization.name}</span>{organization.description}</p>
        )}

        <div class="tdc-hero-actions">
          {featuredEvent ? (
            <a href="#eventos" class="tdc-action-pill">
              <span>Ver actividades </span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/>
                <path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          ) : (
            <a href="#eventos" class="tdc-action-pill">
              <span>Ver actividades </span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14"/>
                <path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Hero Bottom Meta Bar -->
      <div class="tdc-hero-bottom-bar">
        <span class="bottom-credit">Organizado por: <strong>{organization.name}</strong></span>
        <span class="bottom-tag">{organization.slug.toUpperCase()}</span>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. CURATED LINEUP & OVERVIEW SPLIT (Screenshot 2)                        -->
  <!-- ========================================================================= -->
  <section class="tdc-overview-section" id="destacado">
    <div class="tdc-container">
      <div class="tdc-section-eyebrow-line">
        <span>PERÚ · {new Date().getFullYear()}</span>
      </div>

      <div class="tdc-split-grid">
        <div class="tdc-split-left">
          <h2 class="tdc-massive-heading">
            Una programación curada de líderes, investigadores y creadores
          </h2>
        </div>

        <div class="tdc-split-right">
          <p class="tdc-split-paragraph">
            {organization.description || `${organization.name} reúne a especialistas y profesionales líderes en su campo. Cada sesión ofrece una perspectiva de vanguardia y un espacio para conectar e impulsar tu desarrollo.`}
          </p>
          <div class="tdc-split-actions">
            <a href="#eventos" class="tdc-pill-btn primary">
              <span>Ver actividades </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. WORKSHOPS & SESIONES DESTACADAS (Screenshot 3 style)                  -->
  <!-- ========================================================================= -->
  {events.length > 0 && (
    <section class="tdc-workshops-section" id="eventos">
      <div class="tdc-container">
        <div class="tdc-section-header-row">
          <h2 class="tdc-massive-heading">Talleres & Conferencias</h2>
          <div class="tdc-nav-arrows">
            <a href="#eventos" class="arrow-btn" title="Ver anteriores">←</a>
            <a href="#eventos" class="arrow-btn" title="Ver siguientes"></a>
          </div>
        </div>

        <div class="tdc-workshops-grid">
          {events.slice(0, 3).map((evt) => (
            <a href={`/${organization.slug}/events/${evt.id}`} class="tdc-workshop-card">
              <div
                class="workshop-card-img"
                style={evt.coverUrl ? `background-image: url(${evt.coverUrl})` : undefined}
              >
              </div>

              <div class="workshop-card-content">
                <h3 class="workshop-title">{evt.eventName}</h3>
                <p class="workshop-desc">{evt.venueAddress || organization.name}</p>

                <div class="workshop-action-row">
                  <span class="action-circle-btn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M5 12h14"/>
                      <path d="m12 5 7 7-7 7"/>
                    </svg>
                  </span>
                  <span class="action-text">Conocer más</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Listado de eventos publicados -->
  {false && <section class="tdc-stages-section" id="eventos">
    <div class="tdc-container">
      <div class="tdc-stages-header">
        <!-- Búsqueda y filtros de eventos -->
        <div class="tdc-controls-bar">
          <div class="tdc-search-box">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
            <input
              type="text"
              id="event-search-input"
              placeholder="Buscar por título o sede..."
              aria-label="Buscar eventos"
            />
          </div>

          {modes.length > 0 && (
            <div class="tdc-pills-filter">
              <button type="button" class="filter-pill active" data-mode="all">Todos ({events.length})</button>
              {modes.map((m) => (
                <button type="button" class="filter-pill" data-mode={m.toLowerCase()}>{m}</button>
              ))}
            </div>
          )}
        </div>
      </div>

      {events.length > 0 ? (
        <div class="tdc-stage-cards-grid" id="events-grid">
          {events.map((evt) => (
            <a
              href={`/${organization.slug}/events/${evt.id}`}
              class="tdc-stage-card"
              data-card-title={evt.eventName.toLowerCase()}
              data-card-venue={(evt.venueAddress || '').toLowerCase()}
              data-card-mode={(evt.eventMode || '').toLowerCase()}
            >
              <div
                class="stage-card-thumb"
                style={evt.coverUrl ? `background-image: url(${evt.coverUrl})` : undefined}
              >
                <span class="stage-tag">{evt.eventMode || 'Presencial'}</span>
              </div>
              <div class="stage-card-body">
                <time class="stage-time">{dateFormatter.format(new Date(evt.startDate))}</time>
                <h3 class="stage-title">{evt.eventName}</h3>
                <p class="stage-desc">{evt.description || 'Haz clic para revisar la programación y asegurar tu lugar.'}</p>
                <div class="stage-action-link">
                  <span>Ver evento</span>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="m9 18 6-6-6-6"/>
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="tdc-empty-card">
          <div class="empty-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
              <line x1="16" x2="16" y1="2" y2="6"/>
              <line x1="8" x2="8" y1="2" y2="6"/>
              <line x1="3" x2="21" y1="10" y2="10"/>
            </svg>
          </div>
          <h3>No hay eventos publicados actualmente</h3>
          <p>{organization.name} no cuenta con eventos públicos en este momento. Te invitamos a volver pronto para nuevas convocatorias.</p>
        </div>
      )}

      <div id="no-search-results" class="tdc-empty-card" style="display: none;">
        <h3>No encontramos eventos</h3>
        <p>Intenta con otros términos de búsqueda.</p>
      </div>
    </div>
  </section>}
</PortalLayout>

<script>
  // Real Search & Mode Filter Logic
  const searchInput = document.getElementById('event-search-input') as HTMLInputElement | null;
  const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const stageCards = document.querySelectorAll<HTMLElement>('.tdc-stage-card');
  const noResults = document.getElementById('no-search-results');

  let activeMode = 'all';
  let searchQuery = '';

  function applyFilters() {
    let visibleCount = 0;
    stageCards.forEach((card) => {
      const title = card.getAttribute('data-card-title') || '';
      const venue = card.getAttribute('data-card-venue') || '';
      const mode = card.getAttribute('data-card-mode') || '';

      const matchSearch = !searchQuery || title.includes(searchQuery) || venue.includes(searchQuery);
      const matchMode = activeMode === 'all' || mode === activeMode;

      if (matchSearch && matchMode) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 && stageCards.length > 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    applyFilters();
  });

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      activeMode = pill.getAttribute('data-mode') || 'all';
      applyFilters();
    });
  });
</script>

